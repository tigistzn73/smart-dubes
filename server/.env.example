# ============================================================
#  Smart Dube — Environment Variables
#  Copy to `server/.env` for local development.
#  On Render, set these under Dashboard > Environment (never commit .env).
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=5000

# --- Database (PERSISTENCE) ---
# Local: leave DATABASE_URL empty and use the PG_* block below.
# Production (Render free tier): paste a free hosted Postgres connection string.
#   Neon   — https://console.neon.tech  (free tier, no card)
#   Supabase — https://supabase.com    (free tier, no card)
# Without this, the app stores data in server/smart_dube_data.json, which is
# WIPED on every deploy/restart on Render. All SMS history is lost.
DATABASE_URL=

# Local PostgreSQL only
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=smart_dube_system
PG_USER=postgres
PG_PASSWORD=my1919

# --- Auth ---
# Generate a strong value:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Postgres pool ---
# Neon is reached through a pooler, which closes client sockets it considers
# idle. A short idle timeout and a large max pool together cause
# "Connection terminated unexpectedly" on requests that are simple SELECTs.
# PG_POOL_MAX=5
# PG_POOL_IDLE_MS=30000
# PG_CONNECT_TIMEOUT=15000
# Retries apply only to dropped connections, never to SQL errors such as a
# unique or foreign-key violation.
# PG_QUERY_RETRIES=2
# PG_RETRY_DELAY_MS=250

# --- SMTP email (password reset codes) ---
# Password-reset codes are sent to the email captured at registration first,
# and by SMS only as a fallback for accounts with no email on file. Email is the
# better primary: a customer who loses their SIM can never receive an SMS again,
# including the code that would let them back in.
#
# The code lives hashed in users.reset_token in Postgres, expires 5 minutes after
# it is issued, allows 5 wrong guesses before it is destroyed, and is replaced
# (invalidating any earlier code) by the next request. Requests for the same
# account are limited to one per 60 seconds by users.reset_token_sent_at.
#
# With SMTP_HOST unset the app runs in SIMULATION for email — codes are printed
# to the server log and echoed in the API response so local development works
# without credentials. Once SMTP is configured the code is never returned by the
# API.
#
# Any SMTP provider works, and so does any HTTPS email API. Examples:
#   Resend    SMTP_HOST=smtp.resend.com      SMTP_PORT=465 SMTP_SECURE=true
#   SendGrid  SMTP_HOST=smtp.sendgrid.net   SMTP_PORT=587 SMTP_SECURE=false
#   Mailgun   SMTP_HOST=smtp.mailgun.org    SMTP_PORT=587 SMTP_SECURE=false
#   Gmail     SMTP_HOST=smtp.gmail.com      SMTP_PORT=587 SMTP_SECURE=false
# Gmail and Outlook require an App Password, not the account password. Gmail's is
# 16 characters and is created at
#   myaccount.google.com > Security > 2-Step Verification > App passwords
# A personal Gmail account is rate limited (roughly 100 recipients/day on a
# consumer account, 500 on Workspace), so OTP delivery from one is fine for a
# pilot and not for real volume — use a transactional provider then.
#
# ---- Pick a transport that the host can actually reach ----
# SMTP is blocked outright on some hosts, and no configuration rescues it. Render
# blocks outbound 25/465/587 on free web services as of 2025-09-26, so an SMTP
# transport there times out on every port and every provider. Where SMTP is
# unavailable, set an HTTPS API key instead — both providers below talk 443, which
# hosts do not filter. An API key is detected automatically; EMAIL_PROVIDER
# overrides the guess, and "smtp" forces SMTP even when a key is present.
#
#   Brevo    BREVO_API_KEY=xkeysib-...  needs EMAIL_FROM confirmed as a sender.
#                                     Confirms a single address by emailing it, so
#                                     NO DOMAIN IS REQUIRED. Free plan is 300
#                                     sends a day. The only option here that works
#                                     on a host where SMTP is blocked.
#   Resend    RESEND_API_KEY=re_...    needs a VERIFIED DOMAIN; until then it
#                                     delivers only to your own address.
#   SendGrid  SENDGRID_API_KEY=SG...   needs EMAIL_FROM verified as a sender
#                                     identity. No domain needed, but a single
#                                     consumer gmail.com address carries no
#                                     sending reputation and is not aligned with
#                                     the provider signing it, so expect some
#                                     spam placement. A domain you control is
#                                     the durable fix.
# EMAIL_PROVIDER=
# BREVO_API_KEY=
# RESEND_API_KEY=
# SENDGRID_API_KEY=
# EMAIL_FROM=
#
# Returning the reset code in the API response, for local development only.
#
# With no email provider configured the app cannot hand a code to its owner, so
# this is the only way to test the reset flow end to end. It is also a serious
# risk: POST /api/auth/forgot-password needs no authentication, so anything this
# returns is readable by anyone who knows that account's phone number. Keep it
# off in production. The service refuses it when RENDER is set, regardless.
# EXPOSE_OTP_IN_RESPONSE=true
#
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# Fail loudly rather than silently downgrade to plaintext if STARTTLS fails.
# SMTP_REQUIRE_TLS=true
# Brand name used in the subject line and body of every email the app sends.
# APP_NAME=Smart Dube
# nodemailer picks ONE address at random from the relay's A and AAAA records, so
# on a host that advertises IPv6 without a route to it the send fails with
# "connect ENETUNREACH". Render's free tier is exactly that shape. This pins
# resolution to IPv4 for the relay hostnames only, which also stops delivery
# being a coin flip per send on any dual-stack host. Set false only if your relay
# is genuinely reachable over IPv6 and not over IPv4.
# Both of nodemailer's DNS paths have to be pinned for this to hold: it resolves
# with dns.Resolver#resolve4/#resolve6 first and only falls back to dns.lookup
# when both come back empty. Run `npm run test:email:ipv4` after touching it —
# that check reads nodemailer's own candidate list, which is the only thing that
# actually predicts which address gets dialled.
# SMTP_IPV4_ONLY=true

# --- Africa's Talking SMS (optional) ---
# AT_ENV decides whether anything is actually sent:
#   sandbox (default)  no client is built. Messages are recorded and logged
#                      only, and stored as SIMULATED. Africa's Talking rejects a
#                      production key against the sandbox endpoint with a 401, so
#                      sending from here would only produce failures.
#   live               a client is built and messages are sent and billed.
# Leave AT_API_KEY empty to run in SIMULATION mode regardless of AT_ENV.
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=
# AT_ENV=sandbox

# --- Twilio SMS / MMS (optional, preferred gateway) ---
# Twilio is the only gateway that can attach the court letter image to a
# message, so it is tried first. Leave these empty and the app falls back to
# Africa's Talking (text only), then to SIMULATION.
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# Set exactly one sender. A Messaging Service SID is the correct choice in
# production because it owns the number and handles opt-outs.
# TWILIO_FROM_NUMBER=
# TWILIO_MESSAGING_SERVICE_SID=
# On a free trial Twilio only delivers to recipient-verified numbers (error
# 21614). The app recognises that and falls back to the next gateway.

# --- SMS gateway order ---
# Comma-separated, tried left to right. Unconfigured gateways are skipped.
# SMS_GATEWAY_ORDER=twilio,africastalking

# --- Public base URL (required for the court letter image) ---
# Twilio fetches MMS media over the public internet, so a localhost address is
# useless to it. RENDER_EXTERNAL_URL is provided automatically on Render; set
# PUBLIC_BASE_URL to override it, or when running behind another host.
# Without this the letter is still issued and still sent, but as text only.
# PUBLIC_BASE_URL=https://your-app.onrender.com

# --- Court letter image rendering ---
# resvg rasterises the letter from a font on disk. Render's base image ships no
# fonts, so install fonts-dejavu-core in the build, or point these at a .ttf.
# When no font resolves, letters are sent as text rather than as a blank page.
# COURT_LETTER_FONT_FILE=
# COURT_LETTER_SANS_FONT_FILE=
# Optional: sign court letter image URLs with a secret of their own instead of
# reusing JWT_SECRET. Rotate independently of user sessions if you prefer.
# COURT_LETTER_TOKEN_SECRET=
