# ============================================================
#  Smart Dube — Environment Variables
#  Copy to `server/.env` for local development.
#  On Render, set these under Dashboard > Environment (never commit .env).
# ============================================================

# --- Core ---
NODE_ENV=development
PORT=5000

# --- Database (PERSISTENCE) ---
# Local: leave DATABASE_URL empty and use the PG_* block below.
# Production (Render free tier): paste a free hosted Postgres connection string.
#   Neon   — https://console.neon.tech  (free tier, no card)
#   Supabase — https://supabase.com    (free tier, no card)
# Without this, the app stores data in server/smart_dube_data.json, which is
# WIPED on every deploy/restart on Render. All SMS history is lost.
DATABASE_URL=

# Local PostgreSQL only
PG_HOST=localhost
PG_PORT=5433
PG_DATABASE=smart_dube_system
PG_USER=postgres
PG_PASSWORD=my1919

# --- Auth ---
# Generate a strong value:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# --- Africa's Talking SMS (optional) ---
# Leave AT_API_KEY empty to run in SIMULATION mode (logged, never sent).
# NOTE: the SDK only uses the sandbox host when AT_USERNAME is literally
# "sandbox". A real username always hits the LIVE production API and costs
# money, regardless of AT_ENV.
# AT_USERNAME=sandbox
# AT_API_KEY=
# AT_SENDER_ID=
# AT_ENV=sandbox
